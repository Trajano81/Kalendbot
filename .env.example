# Core
OPENAI_API_KEY=sk-...
KALENDBOT_DATA_DIR=./kalendbot-data
KALENDBOT_WEBHOOK_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text  # "text" for development, "json" for production

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_GROUP_CHAT_ID=your-telegram-group-chat-id

# WhatsApp
WHATSAPP_PROVIDER=waha
WHATSAPP_GROUP_CHAT_ID=
WHATSAPP_BOT_JID=5215XXXXXXXXX@c.us

# WAHA config (when WHATSAPP_PROVIDER=waha)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION_NAME=kalendbot
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your-dashboard-password

# LangSmith (optional - for LLM observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kalendbot

# Sentry (optional - for error tracking)
SENTRY_DSN=
